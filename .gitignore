__pycache__/
*.pyc
# data 目錄整批忽略
data/*
build/
dist/
# 由 tools/bump_version.py 自動產生,build 時才需要
version_info.txt

# 含店內資料與人名,絕不入庫(公開 repo)
*.xlsm
*.xlsx

# docs 整個資料夾不入庫(交接、spec、店內資料)
docs/

# 一次性匯入工具(店內資料相關,不入庫);其測試直接 import 該檔,一併不入庫,
# 否則 fresh clone 跑測試會 error(不是 skip)
tools/import_excel.py
tests/test_import_excel.py

# 設計／除錯階段的暫存產物(設計稿、走查腳本與其輸出)
.superpowers/
.tmp_*/

# 執行期產物(與 exe 同層)
pos.db
pos.db.bak-*
# tools/make_standard_db.py 的預設產出(含商品資料,不入庫)
pos_standard.db
error.log
backups/

# 發布說明(給使用者看,不入庫;AGENTS.md C 節)
release_note_v*.md
